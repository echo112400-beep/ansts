FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache curl bash docker-cli
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json wrangler.json wrangler.toml Makefile ./
COPY types ./types
COPY proto ./proto
COPY migrations ./migrations
COPY src ./src
COPY tests ./tests
COPY scripts ./scripts
COPY docs ./docs
RUN node scripts/ci_check.mjs --stage build
EXPOSE 8080 8081 8082 8083 9443 9501 9502
CMD ["node", "scripts/start_body_daemon.mjs"]
