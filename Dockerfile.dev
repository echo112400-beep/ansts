FROM node:22-alpine

WORKDIR /app

# Install curl & bash for healthchecks and cluster bootstrap scripts
RUN apk add --no-cache curl bash

COPY package.json package-lock.json tsconfig.json wrangler.json wrangler.toml Makefile ./
COPY types ./types
COPY proto ./proto
COPY migrations ./migrations
COPY src ./src
COPY tests ./tests
COPY scripts ./scripts
COPY docs ./docs
COPY specs ./specs

RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline --no-audit --no-fund && node scripts/ci_check.mjs --stage build

EXPOSE 8080 8081 8082 8083 9443 9501 9502

CMD ["node", "scripts/start_cluster_node.mjs"]
