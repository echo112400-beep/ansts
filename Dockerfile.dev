FROM node:22-alpine

WORKDIR /app

# Install curl & bash for healthchecks and cluster bootstrap scripts
RUN apk add --no-cache curl bash

COPY package.json tsconfig.json ./
# If node_modules are pre-bundled or installed via npm
RUN npm install --no-audit --no-fund || true

COPY src ./src
COPY tests ./tests
COPY scripts ./scripts
COPY docs ./docs
COPY specs ./specs

# Pre-build TypeScript to CommonJS in dist/
RUN node scripts/ci_check.mjs --stage build

EXPOSE 8080 8081 8082 8083 9443 9501 9502

CMD ["node", "scripts/start_cluster_node.mjs"]
