{
  "name": "ansts-v2-celld-scheduler",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ANSTS_SCHEDULER_CELL",
        "class_name": "AnstsSchedulerCell"
      },
      {
        "name": "ANSTS_HARNESS_CELL",
        "class_name": "AgentTaskHarnessCell"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AnstsSchedulerCell",
        "AgentTaskHarnessCell"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ANSTS_IDEMPOTENCY_KV",
      "id": "ansts_idempotency_kv"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ANSTS_CHECKPOINT_BUCKET",
      "bucket_name": "ansts-checkpoints-l1"
    }
  ],
  "d1_databases": [
    {
      "binding": "ANSTS_D1",
      "database_name": "ansts_audit_d1",
      "database_id": "ansts-d1-prod-001",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ANSTS_TASK_DISPATCH_QUEUE",
        "queue": "ansts-task-dispatch"
      },
      {
        "binding": "ANSTS_WEBHOOK_OUTBOX_QUEUE",
        "queue": "ansts-cloudevents-outbox"
      }
    ],
    "consumers": [
      {
        "queue": "ansts-cloudevents-outbox",
        "max_batch_size": 50,
        "max_retries": 5
      }
    ]
  },
  "worker_loaders": [
    {
      "binding": "ANSTS_SANDBOX_LOADER"
    }
  ],
  "containers": [
    {
      "class_name": "AgentTaskHarnessCell",
      "image": "./deploy/Dockerfile.sandbox",
      "instance_type": "standard-2",
      "max_instances": 128,
      "runtime": "kata"
    }
  ]
}
