{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QF-01 quota policy requests",
  "status": "management-deployed-and-live-verified-enforcement-not-connected",
  "type": "object",
  "required": [
    "expectedVersion",
    "resources",
    "budget",
    "reason"
  ],
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resources": {
      "$ref": "contracts.schema.json#/$defs/ResourceQuota"
    },
    "budget": {
      "type": "object",
      "required": [
        "period",
        "limitCreditUnits",
        "softThresholdBps"
      ],
      "properties": {
        "period": {
          "enum": [
            "UTC_DAY",
            "UTC_MONTH"
          ]
        },
        "limitCreditUnits": {
          "$ref": "contracts.schema.json#/$defs/CreditUnits"
        },
        "softThresholdBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    }
  },
  "operations": [
    {
      "method": "GET",
      "path": "/v1/admin/tenants/{id}/quota",
      "roles": [
        "VIEWER",
        "OPERATOR",
        "SRE_ADMIN"
      ],
      "scope": "tenant and current/historical region",
      "response": "current/history/audit(for SRE)/tenant metadata version; enforcement=NOT_CONNECTED",
      "query": {
        "limit": "integer 1..100, default 25",
        "cursor": "opaque actor/scope/tenant metadata/history snapshot-bound cursor"
      }
    },
    {
      "method": "PUT",
      "path": "/v1/admin/tenants/{id}/quota",
      "roles": [
        "SRE_ADMIN"
      ],
      "scope": "tenant and current/historical region",
      "headers": {
        "Idempotency-Key": "required, 1..128 characters"
      },
      "response": "immutable policy version; enforcement=NOT_CONNECTED"
    }
  ],
  "notes": [
    "Tenant metadata is resolved server-side from the directory, not taken from the request body.",
    "Every policy version pins the observed tenant metadata version; cross-cell metadata activation and execution admission are integrated by QF-02.",
    "Policy storage does not imply admission enforcement or real charging.",
    "History supports bounded cursor pagination; stale snapshots return 409. The management UI supports policy edits and history paging. Store history size remains bounded; execution admission and policy backups are not implemented."
  ]
}
