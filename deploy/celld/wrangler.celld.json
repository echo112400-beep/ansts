{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ansts-celld-brain",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ANSTS_SCHEDULER_CELL",
        "class_name": "AnstsSchedulerCell"
      },
      {
        "name": "ANSTS_HARNESS_CELL",
        "class_name": "AgentTaskHarnessCell"
      },
      {
        "name": "ANSTS_TUNNEL_CELL",
        "class_name": "TunnelGatewayCell"
      },
      {
        "name": "ANSTS_BODY_CELL",
        "class_name": "AnstsBodyCell"
      },
      {
        "name": "ANSTS_GATEWAY_CELL",
        "class_name": "AnstsGatewayCell"
      },
      {
        "name": "ANSTS_TENANT_DIRECTORY_CELL",
        "class_name": "TenantDirectoryCell"
      },
      {
        "name": "ANSTS_TENANT_CONTROL_CELL",
        "class_name": "TenantControlCell"
      },
      {
        "name": "ANSTS_ADMISSION_MAILBOX",
        "class_name": "AdmissionShadowMailboxCell"
      },
      {
        "name": "ANSTS_CAPACITY_INVENTORY_CELL",
        "class_name": "CapacityInventoryCell"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AnstsSchedulerCell",
        "AgentTaskHarnessCell",
        "TunnelGatewayCell"
      ]
    },
    {
      "tag": "v2-body",
      "new_sqlite_classes": [
        "AnstsBodyCell"
      ]
    },
    {
      "tag": "v3-gateway",
      "new_sqlite_classes": [
        "AnstsGatewayCell"
      ]
    },
    {
      "tag": "v4-tenant-directory",
      "new_sqlite_classes": [
        "TenantDirectoryCell"
      ]
    },
    {
      "tag": "v5-tenant-control",
      "new_sqlite_classes": [
        "TenantControlCell"
      ]
    },
    {
      "tag": "v6-admission-shadow-mailbox",
      "new_sqlite_classes": [
        "AdmissionShadowMailboxCell"
      ]
    },
    {
      "tag": "v7-capacity-inventory",
      "new_sqlite_classes": [
        "CapacityInventoryCell"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ANSTS_ROUTING_KV",
      "id": "00000000000000000000000000000001"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ANSTS_LAYERFS_BUCKET",
      "bucket_name": "ansts-fleet"
    }
  ],
  "d1_databases": [
    {
      "binding": "ANSTS_SCHEDULER_D1",
      "database_name": "ansts-scheduler",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ANSTS_TELEMETRY_QUEUE",
        "queue": "ansts-telemetry"
      }
    ],
    "consumers": [
      {
        "queue": "ansts-telemetry",
        "max_batch_size": 100,
        "max_batch_timeout": 5
      }
    ]
  },
  "vars": {
    "ANSTS_BODY_WORKER_URL": "",
    "ANSTS_BODY_AUTH_SECRET": "",
    "CELLD_REGION": "celld-scheduler",
    "CELLD_REBALANCE_INTERVAL_MS": "5000",
    "ANSTS_BODY_AUTH_PREVIOUS_SECRET": "",
    "ANSTS_BODY_AUTH_PREVIOUS_UNTIL": "",
    "ANSTS_BODY_NAMESPACE_PREFIX": "",
    "ANSTS_DIRECTORY_SERVICE_TOKEN": "",
    "ANSTS_ADMISSION_SERVICE_TOKEN": "",
    "ANSTS_ADMISSION_SIGNING_KEY": ""
  }
}
