RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfs_prod_secret_key_2026
CELLD_BUCKET=s3://ansts-fleet
S3_ENDPOINT=http://127.0.0.1:9000
AWS_REGION=us-east-1
ANSTS_PORT=8080
ANSTS_DASHBOARD_PORT=8090
# HMAC secret for console write APIs. Unset refuses those writes. Do not commit a real value.
ANSTS_CONSOLE_RBAC_SECRET=
# Bearer token the console and anstsctl send as Authorization. Issued with the secret above.
ANSTS_CONSOLE_TOKEN=
# Console agent. Provider "openai" uses @tanstack/ai-openai and reads OPENAI_API_KEY.
# Leave these empty to make POST /v1beta1/console/agent/chat return 503.
ANSTS_CONSOLE_AGENT_PROVIDER=
ANSTS_CONSOLE_AGENT_MODEL=
OPENAI_API_KEY=
