# ANSTS local RustFS / celld credentials
#
# Copy this file to `.env` (gitignored, never committed) and fill in your own:
#   cp .env.example .env
#   sed -i "s|^RUSTFS_ACCESS_KEY=.*|RUSTFS_ACCESS_KEY=$(openssl rand -hex 12)|" .env
#   sed -i "s|^RUSTFS_SECRET_KEY=.*|RUSTFS_SECRET_KEY=$(openssl rand -hex 24)|" .env
#
# The startup script refuses to run without these — there is deliberately no
# hardcoded default, because committed defaults end up in public git history.

RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Optional overrides (defaults live in the script):
# S3_ENDPOINT=http://127.0.0.1:9000
# CELLD_BUCKET=s3://ansts-fleet
# NODE_PUBLIC_LISTEN=0.0.0.0:8080
