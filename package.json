{
  "name": "ansts-v2-celld-scheduler",
  "version": "2.2.0",
  "description": "Agent-Native Sandbox Task Scheduler (ANSTS v2.2) on denoland/celld, Cloudflare Workers, LayerFS, and RustFS EC:4",
  "private": true,
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/server_main.js",
    "dev": "node dist/src/server_main.js",
    "lint": "node scripts/ci_check.mjs --stage lint",
    "build": "node scripts/ci_check.mjs --stage build",
    "test": "node scripts/ci_check.mjs --stage test",
    "ci": "node scripts/ci_check.mjs --stage all",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "prestart": "node scripts/ci_check.mjs --stage build-if-missing",
    "dev:cluster:up": "cat deploy/dev-cluster/dev-cluster-up.sh | bash",
    "dev:cluster:down": "cat deploy/dev-cluster/dev-cluster-down.sh | bash",
    "start:local": "cat scripts/run-local.sh | bash",
    "start:celld-worker": "bash scripts/celld_worker_up.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/parser": "^7.20.0",
    "@babel/plugin-transform-modules-commonjs": "^7.20.0",
    "@babel/plugin-transform-typescript": "^7.20.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.11",
    "js-yaml": "^4.1.0",
    "typescript": "^5.3.0"
  }
}
