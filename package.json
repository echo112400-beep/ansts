{
  "name": "@ansts/scheduler-v2",
  "version": "2.0.0",
  "description": "Agent-Native Sandbox Task Scheduler (ANSTS v2.0) — TypeScript Microservices with denoland/celld & Cloudflare Workers Support",
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "types": "src/index.ts",
  "scripts": {
    "lint": "NODE_PATH=/usr/share/nodejs node scripts/ci_check.mjs --stage lint",
    "build": "NODE_PATH=/usr/share/nodejs node scripts/ci_check.mjs --stage build",
    "test": "NODE_PATH=/usr/share/nodejs node scripts/ci_check.mjs --stage test",
    "ci": "NODE_PATH=/usr/share/nodejs node scripts/ci_check.mjs --stage all",
    "dev:celld": "celld dev --port 9876",
    "deploy:celld": "celld deploy . --bucket ${CELLD_BUCKET:-s3://my-celld-fleet} --region auto",
    "d1:migrate:celld": "celld d1 migrations apply ansts-audit-ledger --bucket ${CELLD_BUCKET:-s3://my-celld-fleet}",
    "dev:cf": "wrangler dev",
    "deploy:cf": "wrangler deploy",
    "d1:migrate:cf": "wrangler d1 migrations apply ansts-audit-ledger --remote"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/parser": "^7.20.0",
    "@babel/plugin-transform-modules-commonjs": "^7.20.0",
    "@babel/preset-typescript": "^7.20.0",
    "@types/node": "^18.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.0",
    "wrangler": "^3.80.0"
  }
}
